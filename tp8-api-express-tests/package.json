{
  "name": "contact-api",
  "version": "1.0.0",
  "private": true,
  "description": "API Express du TP8 : formulaire de contact sécurisé et testé",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run tests --exclude tests/integration/**",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run tests --exclude tests/integration/** --coverage",
    "migrate": "node src/migrate.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.0",
    "supertest": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
